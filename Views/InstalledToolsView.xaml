<UserControl x:Class="ToolkitApp.Views.InstalledToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="txtSearch" Height="32" TextChanged="TxtSearch_Changed"/>
                <TextBlock x:Name="lblHint" Text="Filter your library…" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="lblCount" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstCards">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,14,14" Width="250" Height="170"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ToolTip="{Binding Tooltip}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,28,0"/>
                                    <Button Content="{Binding FavoriteGlyph}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Fav_Click" Style="{StaticResource GhostButton}" Foreground="Goldenrod" Padding="4,0" ToolTip="Toggle favorite"/>
                                </Grid>
                                <TextBlock Grid.Row="1" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding Category, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Badge, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="{Binding Command}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="▶ Run" Click="Run_Click" Padding="12,4" Margin="0,0,6,0"/>
                                    <Button Content="✎" Click="Edit_Click" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0" ToolTip="Edit"/>
                                    <Button Content="🗑" Click="Delete_Click" Style="{StaticResource SecondaryButton}" Padding="10,4" ToolTip="Delete"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
