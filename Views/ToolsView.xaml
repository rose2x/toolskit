<UserControl x:Class="ToolkitApp.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="260" MaxWidth="560"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Grid Margin="0,0,0,8">
                    <TextBox x:Name="txtSearch" Height="32" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock x:Name="lblSearchHint" Text="Search name, command, category…  (Ctrl+F)" Foreground="{DynamicResource MutedBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ComboBox x:Name="cmbCategory" SelectionChanged="CmbCategory_Changed"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource BgPanelBrush}" CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="lstTools" SelectionChanged="LstTools_SelectionChanged" MouseDoubleClick="LstTools_DoubleClick"
                             HorizontalContentAlignment="Stretch" Margin="2">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="8,10,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FavoriteGlyph}" Foreground="Goldenrod" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Command}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="16" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Badge}" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="8,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="lblEmpty" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center" Margin="20" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" Text="No tools match.&#x0A;Create one with “New”, drop a script here, or search GitHub (Ctrl+Q)."/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="btnRun" Content="▶  Run" Click="BtnRun_Click" Margin="0,0,6,0"/>
                    <Button x:Name="btnRunAdmin" Grid.Column="1" Content="🛡  Admin" Click="BtnRunAdmin_Click" Style="{StaticResource DangerButton}" Margin="0,0,6,0"/>
                    <Button x:Name="btnStop" Grid.Column="2" Content="■  Stop" Click="BtnStop_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </Grid>
                <UniformGrid Grid.Row="1" Rows="1">
                    <Button x:Name="btnNew" Content="＋ New" Click="BtnNew_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="4,6"/>
                    <Button x:Name="btnEdit" Content="✎ Edit" Click="BtnEdit_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="4,6"/>
                    <Button x:Name="btnDuplicate" Content="⧉ Copy" Click="BtnDuplicate_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="4,6"/>
                    <Button x:Name="btnFav" Content="★" ToolTip="Toggle favorite" Click="BtnFav_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="4,6"/>
                    <Button x:Name="btnDelete" Content="🗑" ToolTip="Delete" Click="BtnDelete_Click" Style="{StaticResource SecondaryButton}" Padding="4,6"/>
                </UniformGrid>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- Right: terminal -->
        <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource TerminalBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" CornerRadius="8,8,0,0" Padding="12,6">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="lblTitle" Text="Terminal output" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Content="Clear" DockPanel.Dock="Right" Click="BtnClear_Click" Style="{StaticResource GhostButton}"/>
                        <Button Content="Save…" DockPanel.Dock="Right" Click="BtnSave_Click" Style="{StaticResource GhostButton}"/>
                        <Button Content="Copy" DockPanel.Dock="Right" Click="BtnCopy_Click" Style="{StaticResource GhostButton}"/>
                        <CheckBox x:Name="chkWrap" Content="Wrap" DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center" Checked="Wrap_Changed" Unchecked="Wrap_Changed"/>
                        <CheckBox x:Name="chkScroll" Content="Auto-scroll" DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center" Checked="Scroll_Changed" Unchecked="Scroll_Changed"/>
                    </DockPanel>
                </Border>
                <ProgressBar x:Name="progress" Grid.Row="1" IsIndeterminate="False" Visibility="Hidden"/>

                <RichTextBox x:Name="txtTerminal" Grid.Row="2" IsReadOnly="True" Background="Transparent"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                <Grid x:Name="pnlInput" Grid.Row="3" Margin="10,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtInput" KeyDown="TxtInput_KeyDown" FontFamily="Consolas"/>
                    <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Click="BtnSend_Click"/>
                </Grid>

                <Border Grid.Row="4" Background="{DynamicResource BgPanelBrush}" CornerRadius="0,0,8,8" Padding="12,6">
                    <Grid>
                        <TextBlock x:Name="lblResult" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Ready"/>
                        <TextBlock x:Name="lblElapsed" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
