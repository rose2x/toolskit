<Window x:Class="ToolkitApp.Views.ToolEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool" Height="720" Width="760" MinHeight="520" MinWidth="620"
        Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="{DynamicResource UiFontSize}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock x:Name="lblHeader" FontSize="24" FontWeight="Light" Margin="0,0,0,14"/>

                <TextBlock Text="Name" Margin="0,0,0,3"/>
                <TextBox x:Name="txtName" Margin="0,0,0,12"/>

                <TextBlock Text="Command" Margin="0,0,0,3"/>
                <TextBox x:Name="txtCommand" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,0,0,2"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                           Text="Use {{name}} or {{name:default}} for values you are asked for on every run. Several lines run one after another."/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Shell" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbShell" SelectionChanged="CmbShell_Changed"/>
                        <TextBlock x:Name="lblShellHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbCategory" IsEditable="True"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Description (optional)" Margin="0,0,0,3"/>
                <TextBox x:Name="txtDescription" Margin="0,0,0,12"/>

                <TextBlock Text="Working directory (optional)" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="txtWorkDir"/>
                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" Style="{StaticResource SecondaryButton}"/>
                </Grid>

                <TextBlock Text="Environment variables (KEY=VALUE per line)" Margin="0,0,0,3"/>
                <TextBox x:Name="txtEnv" AcceptsReturn="True" MinHeight="60" MaxHeight="120" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Timeout (seconds, 0 = none)" FontSize="12" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtTimeout" Text="0"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkFavorite" Content="★  Favorite (pinned on Home)"/>
                <CheckBox x:Name="chkAdmin" Content="🛡  Always run as administrator"/>
                <CheckBox x:Name="chkKeepOpen" Content="Admin runs: keep the elevated console window open (otherwise output is captured here)" Margin="26,0,0,12"/>

                <Border Background="#0C0C0C" CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="README / documentation" Foreground="#AAA" FontSize="12" FontWeight="Bold" Margin="10,8,10,4"/>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="10,0,10,10">
                            <TextBlock x:Name="txtReadme" Foreground="#CCC" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="110" Height="34" IsDefault="True" Click="Save_Click" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="100" Height="34" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
