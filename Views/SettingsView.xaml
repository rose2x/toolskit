<UserControl x:Class="ToolkitApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,16,0">

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Theme" Margin="0,0,0,3"/>
                                <ComboBox x:Name="cmbTheme"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Interface font size" Margin="0,0,0,3"/>
                                <ComboBox x:Name="cmbUiFont"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Accent color" Margin="0,14,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="accentPreview" Width="32" Height="32" CornerRadius="5" Margin="0,0,8,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                            <TextBox x:Name="txtAccent" Width="110" Height="32" TextChanged="Accent_Changed" Margin="0,0,12,0"/>
                            <StackPanel x:Name="pnlSwatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Terminal font" Margin="0,0,0,3"/>
                                <ComboBox x:Name="cmbTermFont" IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Terminal size" Margin="0,0,0,3"/>
                                <ComboBox x:Name="cmbTermSize"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Terminal color scheme" Margin="0,14,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="16"/><ColumnDefinition Width="110"/><ColumnDefinition Width="8"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbScheme" SelectionChanged="Scheme_Changed"/>
                            <TextBox Grid.Column="2" x:Name="txtTermBg" Height="32" ToolTip="Background"/>
                            <TextBox Grid.Column="4" x:Name="txtTermFg" Height="32" ToolTip="Text color"/>
                        </Grid>
                        <TextBlock Text="Colors are hex like #0C0C0C: background first, then text." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <TextBlock Text="BEHAVIOR" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Default shell for new tools" Margin="0,0,0,3"/><ComboBox x:Name="cmbShell"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Open on startup" Margin="0,0,0,3"/><ComboBox x:Name="cmbStart"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Max output lines" Margin="0,0,0,3"/><ComboBox x:Name="cmbMaxLines"/></StackPanel>
                        </Grid>
                        <CheckBox x:Name="chkClear" Content="Clear the terminal before each run" Margin="0,14,0,4"/>
                        <CheckBox x:Name="chkAutoScroll" Content="Auto-scroll to newest output"/>
                        <CheckBox x:Name="chkWrap" Content="Wrap long lines"/>
                        <CheckBox x:Name="chkTime" Content="Show timestamps in output"/>
                        <CheckBox x:Name="chkConfirmAdmin" Content="Ask before running as administrator"/>
                        <CheckBox x:Name="chkConfirmDelete" Content="Ask before deleting a tool"/>
                    </StackPanel>
                </Border>

                <!-- GitHub -->
                <TextBlock Text="GITHUB &amp; DOWNLOADS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Personal access token (optional – raises the search rate limit)" Margin="0,0,0,3"/>
                        <PasswordBox x:Name="pwdToken" Height="32"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,14"
                                   Text="Create a token with NO scopes at github.com/settings/tokens. It is stored in your config file (not in the app). The GITHUB_TOKEN environment variable is used if this is empty."/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Clone destination folder" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtToolsDir" Height="32"/>
                                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="BrowseTools_Click" Style="{StaticResource SecondaryButton}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Results per page" Margin="0,0,0,3"/>
                                <ComboBox x:Name="cmbPage"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data -->
                <TextBlock Text="DATA" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Export tools…" Click="Export_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Import tools…" Click="Import_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Add starter pack" Click="Starter_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Open config folder" Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button Content="Reset settings" Click="Reset_Click" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="lblPath" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Apply &amp; save" Width="140" Height="34" Click="Apply_Click" Margin="0,0,10,0"/>
                <Button Content="Revert" Width="100" Height="34" Click="Revert_Click" Style="{StaticResource SecondaryButton}"/>
                <TextBlock x:Name="lblSaved" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource SuccessBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
