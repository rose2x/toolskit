<UserControl x:Class="ToolkitApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Welcome to Tool Kit" FontSize="34" FontWeight="Light"/>
            <TextBlock x:Name="txtSummary" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,20"/>

            <WrapPanel Margin="0,0,0,26">
                <Button Content="▶  Run Tools" Margin="0,0,10,0" Click="Quick_Click" Tag="Tools"/>
                <Button Content="＋  New tool" Margin="0,0,10,0" Click="NewTool_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="🔍  Find on GitHub" Margin="0,0,10,0" Click="Quick_Click" Tag="Github" Style="{StaticResource SecondaryButton}"/>
                <Button Content="⚙  Settings" Click="Quick_Click" Tag="Settings" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>

            <TextBlock Text="★  FAVORITES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="txtNoFav" Text="Star a tool in Installed Tools to pin it here for one-click launching." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20"/>
            <ItemsControl x:Name="lstFav" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Tool_Click" Margin="0,0,10,10" Padding="16,10" Style="{StaticResource SecondaryButton}" ToolTip="{Binding Tooltip}" HorizontalContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="🕘  RECENTLY RUN" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="txtNoRecent" Text="Nothing has been run yet." Foreground="{DynamicResource MutedBrush}"/>
            <ItemsControl x:Name="lstRecent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Tool_Click" Margin="0,0,0,6" Padding="14,8" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Tooltip}">
                            <Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LastRunText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
