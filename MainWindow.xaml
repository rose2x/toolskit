<Window x:Class="ToolkitApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool Kit" Height="720" Width="1100" MinHeight="560" MinWidth="900"
        Icon="icon.ico"
        Background="{DynamicResource BgBaseBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="{DynamicResource UiFontSize}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="txtVersion" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="20,0,0,14"/>
                <StackPanel x:Name="NavPanel" Margin="0,22,0,0">
                    <TextBlock Text="TOOL KIT" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold" Margin="22,0,0,24"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="🏠  Home" Tag="Home" Click="Nav_Click"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="▶  Run Tools" Tag="Tools" Click="Nav_Click"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="🗂  Installed Tools" Tag="Installed" Click="Nav_Click"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="🔍  GitHub  (Ctrl+Q)" Tag="Github" Click="Nav_Click"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="⚙  Settings" Tag="Settings" Click="Nav_Click"/>
                    <RadioButton Style="{StaticResource NavRadio}" Content="ℹ  About" Tag="About" Click="Nav_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="txtPageTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0,0,0"/>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="20" IsTabStop="False"/>

            <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <TextBlock x:Name="txtStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtConfigPath" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
